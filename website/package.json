{
  "name": "pullmd-docs",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Source of the PullMD documentation site.",
  "scripts": {
    "start": "docusaurus start",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "gen-api": "node scripts/gen-api.mjs",
    "clean-api": "node -e \"require('fs').rmSync('docs/reference/api',{recursive:true,force:true});require('fs').rmSync('src/generated',{recursive:true,force:true})\"",
    "prestart": "node scripts/gen-api.mjs",
    "prebuild": "node scripts/gen-api.mjs"
  },
  "engines": {
    "node": ">=20.0"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/utils": "3.10.2",
    "@docusaurus/utils-validation": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "js-yaml": "4.3.2",
    "prism-react-renderer": "2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "typescript": "5.9.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
